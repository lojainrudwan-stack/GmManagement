@model GymManagement.Domain.Entities.Coach
@{
    ViewData["Title"] = "إضافة مدرب";
}

<div class="page-header">
    <h1 class="page-title">إضافة مدرب جديد</h1>
    <a href="@Url.Action("Index")" class="btn btn-secondary">← رجوع</a>
</div>

<div class="form-card">
    <form method="post" asp-action="Create">
        @Html.AntiForgeryToken()

        <div class="form-group">
            <label asp-for="Name">الاسم</label>
            <input asp-for="Name" placeholder="اسم المدرب" />
        </div>

        <div class="form-group">
            <label asp-for="Specialization">التخصص</label>
            <input asp-for="Specialization" placeholder="مثال: كمال الأجسام" />
        </div>

        <div class="form-group">
            <label asp-for="Phone">الهاتف</label>
            <input asp-for="Phone" placeholder="05XXXXXXXX" />
        </div>

        <div class="form-group">
            <label asp-for="Status">الحالة</label>
            <select asp-for="Status">
                <option value="نشط">نشط</option>
                <option value="غير نشط">غير نشط</option>
            </select>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">حفظ</button>
            <a href="@Url.Action("Index")" class="btn btn-secondary">إلغاء</a>
        </div>
    </form>
</div>

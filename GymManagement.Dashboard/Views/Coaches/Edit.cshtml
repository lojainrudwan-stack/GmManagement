@model GymManagement.Domain.Entities.Coach
@{
    ViewData["Title"] = "تعديل مدرب";
}

<div class="page-header">
    <h1 class="page-title">تعديل بيانات المدرب</h1>
    <a href="@Url.Action("Index")" class="btn btn-secondary">← رجوع</a>
</div>

<div class="form-card">
    <form method="post" asp-action="Edit" asp-route-id="@Model.CoachId">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="CoachId" />

        <div class="form-group">
            <label asp-for="Name">الاسم</label>
            <input asp-for="Name" />
        </div>

        <div class="form-group">
            <label asp-for="Specialization">التخصص</label>
            <input asp-for="Specialization" />
        </div>

        <div class="form-group">
            <label asp-for="Phone">الهاتف</label>
            <input asp-for="Phone" />
        </div>

        <div class="form-group">
            <label asp-for="Status">الحالة</label>
            <select asp-for="Status">
                <option value="نشط">نشط</option>
                <option value="غير نشط">غير نشط</option>
            </select>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">حفظ التغييرات</button>
            <a href="@Url.Action("Index")" class="btn btn-secondary">إلغاء</a>
        </div>
    </form>
</div>
